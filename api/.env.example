# ==============================================================================
# API POCblockchain - Variables de Entorno (Plantilla Genérica)
# Copia este archivo como .env en este mismo directorio y completa los valores.
# ==============================================================================

# Puerto y entorno del servidor Express
PORT=3000
NODE_ENV=development

# Blockchain Node RPC URL (Hardhat Local: http://127.0.0.1:8545, Sepolia, Polygon, etc.)
RPC_URL=http://127.0.0.1:8545

# Dirección del Smart Contract ERC-1155 desplegado (MielBierzoDPP1155)
CONTRACT_ADDRESS_1155=0x0000000000000000000000000000000000000000

# Clave privada del Relayer / Operador Web3 (patrocina y orquesta transacciones)
RELAYER_PRIVATE_KEY=your_relayer_private_key_here

# Dominio público para resolución de códigos GS1 Digital Link
DOMAIN=http://localhost:3000

# URL base interna de la API para llamadas de oráculos y servicios
API_BASE_URL=http://localhost:3000
