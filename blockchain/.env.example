# ==============================================================================
# Blockchain Hardhat - Variables de Entorno (Plantilla Genérica)
# Copia este archivo como .env en este mismo directorio y completa los valores.
# ==============================================================================

# Proveedores RPC para despliegue en redes de prueba o principales
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Clave privada de la cuenta de despliegue (Deployer / Admin)
PRIVATE_KEY=your_deployer_private_key_without_0x_prefix

# API Key de Etherscan para verificación automatizada del contrato
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Direcciones opcionales para inicializar roles en el script de despliegue
ADMIN_ADDRESS=
RELAYER_ADDRESS=
CONSEJO_REGULADOR_ADDRESS=
